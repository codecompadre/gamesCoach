# Reference only: gamesCoach does NOT automatically load .env files.
# Export variables in your shell or configure them securely in your environment.
# Never commit real keys or paste them into a profile, plan request, or chat.

OPENAI_API_KEY=replace_with_your_openai_api_key
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Accepted alternatives:
# GAMESCOACH_OPENAI_API_KEY=replace_with_your_openai_api_key
# GOOGLE_API_KEY=replace_with_your_gemini_api_key
# GAMESCOACH_GEMINI_API_KEY=replace_with_your_gemini_api_key

OPENAI_MODEL=gpt-5-mini
GEMINI_MODEL=gemini-flash-latest

# Optional local storage directory. Default: $XDG_DATA_HOME/gamescoach,
# or ~/.local/share/gamescoach when XDG_DATA_HOME is unset.
# GAMESCOACH_DATA_DIR=/absolute/path/to/private/gamescoach-data

# Optional plain-text coaching preferences shared with both providers in live mode.
# Notes cannot override the fixed CrossFit scope or system constraints.
# No secrets. This file is not auto-loaded; export the variable explicitly.
# GAMESCOACH_COACH_NOTES_FILE=/absolute/path/to/coach-notes.local.md
